# The LLM: PhoneLLM behind the polyloop proxy on the Modal node (public https URL printed by the launcher).
# For a dry run without the node: POLYVOICE_PROXY_URL=https://api.generalcompute.com/v1  POLYVOICE_MODEL=gemma-4-31B-it
POLYVOICE_PROXY_URL=
POLYVOICE_MODEL=polyvoice/live
POLYVOICE_API_KEY=polyvoice

# Voice (hackathon stack)
GRADIUM_API_KEY=
# GRADIUM_VOICE_ID=

# Sandbox caller + judge for `polyvoice` rollouts (any OpenAI-compatible endpoint with tool calling)
GENERAL_COMPUTE_API_KEY=
